generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum StudioRole {
  SUPER_ADMIN
  SUPPORT
  CONTENT
  ANALYST
}

enum AuthProvider {
  KAKAO
  GOOGLE
}

enum CoupleStatus {
  ACTIVE
  DISSOLVED
}

enum SourceType {
  PUBLIC_API
  BUSINESS
  EDITOR
  UGC
}

enum PlaceStatus {
  ACTIVE
  CLOSED
  MERGED
}

enum PlaceKind {
  CAFE
  RESTAURANT
  BAR
  SHOP
  CINEMA
  MUSEUM
  GALLERY
  PARK
  ACTIVITY
  CULTURAL_VENUE
  OTHER
}

enum VenueOperatorType {
  PUBLIC
  PRIVATE
  NONPROFIT
  UNKNOWN
}

enum ExternalProvider {
  KAKAO
  NAVER
  GOOGLE
  TOUR_API
  SEOUL_OPEN_DATA
  CULTURE_PORTAL
  KOPIS
  KOBIS
  OFFICIAL_SITE
}

enum HappeningStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum HappeningKind {
  EXHIBITION
  POPUP
  FESTIVAL
  PERFORMANCE
  SCREENING
  WORKSHOP
  EVENT
  OTHER
}

enum IngestionStatus {
  STAGED
  NORMALIZED
  MERGED
  REJECTED
  FAILED
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum IngestionTrigger {
  MANUAL
  SCHEDULED
}

enum ScheduleOccurrenceStatus {
  SCHEDULED
  CANCELLED
  SOLD_OUT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  PRIVATE
  DELETED
}

enum SupportCaseType {
  INQUIRY
  COMPLAINT
  REPORT
  PRIVACY
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportEntryKind {
  CUSTOMER_MESSAGE
  STAFF_REPLY
  INTERNAL_NOTE
}

enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum TagKind {
  SITUATION
  BUDGET
  MOOD
  CATEGORY
}

enum ActorType {
  HUMAN
  AGENT
}

model User {
  id                    String           @id @default(cuid())
  email                 String?          @unique
  nickname              String
  profileImageUrl       String?          @map("profile_image_url")
  status                UserStatus       @default(ACTIVE)
  studioRole            StudioRole?      @map("studio_role")
  statusReason          String?          @map("status_reason") @db.VarChar(500)
  suspendedUntil        DateTime?        @map("suspended_until")
  statusChangedAt       DateTime?        @map("status_changed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")
  authIdentities        AuthIdentity[]
  coupleMemberships     CoupleMember[]
  soloCourses           Course[]         @relation("SoloCourseCreator")
  scraps                Scrap[]
  events                AnalyticsEvent[]
  createdCoupleInvites  CoupleInvite[]   @relation("CoupleInviteCreator")
  acceptedCoupleInvites CoupleInvite[]   @relation("CoupleInviteAccepter")
  reportedSupportCases  SupportCase[]    @relation("SupportCaseReporter")
  assignedSupportCases  SupportCase[]    @relation("SupportCaseAssignee")
  notificationDeliveries NotificationDelivery[] @relation("NotificationRecipient")

  @@index([status, createdAt])
  @@index([status, suspendedUntil])
  @@index([studioRole])
  @@map("users")
}

model SupportCase {
  id             String             @id @default(cuid())
  reporterUserId String?            @map("reporter_user_id")
  assigneeUserId String?            @map("assignee_user_id")
  type           SupportCaseType
  priority       SupportPriority    @default(NORMAL)
  status         SupportCaseStatus  @default(OPEN)
  subject        String
  description    String             @db.VarChar(5000)
  targetType     String?            @map("target_type")
  targetId       String?            @map("target_id")
  dueAt          DateTime?          @map("due_at")
  resolvedAt     DateTime?          @map("resolved_at")
  closedAt       DateTime?          @map("closed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  reporter       User?              @relation("SupportCaseReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  assignee       User?              @relation("SupportCaseAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  entries        SupportCaseEntry[]

  @@index([status, priority, createdAt, id])
  @@index([assigneeUserId, status, dueAt])
  @@index([reporterUserId, createdAt])
  @@index([targetType, targetId])
  @@map("support_cases")
}

model SupportCaseEntry {
  id            String           @id @default(cuid())
  supportCaseId String           @map("support_case_id")
  kind          SupportEntryKind
  authorId      String           @map("author_id")
  authorType    ActorType        @map("author_type")
  body          String           @db.VarChar(5000)
  createdAt     DateTime         @default(now()) @map("created_at")
  supportCase   SupportCase      @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  deliveries    NotificationDelivery[]

  @@index([supportCaseId, createdAt, id])
  @@map("support_case_entries")
}

model NotificationDelivery {
  id                  String                     @id @default(cuid())
  supportCaseEntryId  String                     @map("support_case_entry_id")
  recipientUserId     String                     @map("recipient_user_id")
  channel             NotificationChannel
  status              NotificationDeliveryStatus @default(PENDING)
  dedupeKey           String                     @unique @map("dedupe_key")
  attemptCount        Int                        @default(0) @map("attempt_count")
  nextAttemptAt       DateTime                   @default(now()) @map("next_attempt_at")
  lockedAt            DateTime?                  @map("locked_at")
  providerMessageId   String?                    @map("provider_message_id")
  lastError           String?                    @map("last_error") @db.VarChar(1000)
  sentAt              DateTime?                  @map("sent_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  supportCaseEntry    SupportCaseEntry           @relation(fields: [supportCaseEntryId], references: [id], onDelete: Cascade)
  recipient           User                       @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([supportCaseEntryId, channel])
  @@index([status, nextAttemptAt, id])
  @@index([recipientUserId, createdAt])
  @@map("notification_deliveries")
}

model AuthIdentity {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  provider   AuthProvider
  externalId String       @map("external_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("auth_identities")
}

model Couple {
  id          String         @id @default(cuid())
  displayName String         @map("display_name")
  startedAt   DateTime       @map("started_at")
  status      CoupleStatus   @default(ACTIVE)
  dissolvedAt DateTime?      @map("dissolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  members     CoupleMember[]
  courses     Course[]

  @@index([status, createdAt])
  @@map("couples")
}

model CoupleMember {
  id       String    @id @default(cuid())
  coupleId String    @map("couple_id")
  userId   String    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  couple   Couple    @relation(fields: [coupleId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([coupleId, userId])
  @@index([userId, leftAt])
  @@map("couple_members")
}

model CoupleInvite {
  id                        String    @id @default(cuid())
  inviterUserId             String    @map("inviter_user_id")
  acceptedByUserId          String?   @map("accepted_by_user_id")
  tokenHash                 String    @unique @map("token_hash") @db.Char(64)
  startedAt                 DateTime  @map("started_at") @db.Date
  inviterUpgradeSoloCourses Boolean   @default(false) @map("inviter_upgrade_solo_courses")
  expiresAt                 DateTime  @map("expires_at")
  acceptedAt                DateTime? @map("accepted_at")
  revokedAt                 DateTime? @map("revoked_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  inviter                   User      @relation("CoupleInviteCreator", fields: [inviterUserId], references: [id], onDelete: Cascade)
  acceptedBy                User?     @relation("CoupleInviteAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([inviterUserId, createdAt])
  @@index([expiresAt])
  @@map("couple_invites")
}

model Place {
  id                String                                @id @default(cuid())
  sourceType        SourceType                            @map("source_type")
  status            PlaceStatus                           @default(ACTIVE)
  category          String
  kind              PlaceKind?
  operatorType      VenueOperatorType                     @default(UNKNOWN) @map("operator_type")
  areaSlug          String?                               @map("area_slug")
  lat               Decimal                               @db.Decimal(9, 6)
  lng               Decimal                               @db.Decimal(9, 6)
  location          Unsupported("geography(Point,4326)")?
  phone             String?
  websiteUrl        String?                               @map("website_url")
  createdAt         DateTime                              @default(now()) @map("created_at")
  updatedAt         DateTime                              @updatedAt @map("updated_at")
  translations      PlaceTranslation[]
  providerRefs      PlaceProviderRef[]
  openingPeriods    PlaceOpeningPeriod[]
  openingExceptions PlaceOpeningException[]
  happenings        Happening[]
  courseNodes       CourseNode[]
  tags              PlaceTag[]

  @@index([status, category])
  @@index([status, kind, areaSlug])
  @@index([operatorType, kind])
  @@index([status, areaSlug, category, id])
  @@index([sourceType, createdAt])
  @@index([location], type: Gist, map: "places_location_gist_idx")
  @@map("places")
}

model PlaceTranslation {
  id      String  @id @default(cuid())
  placeId String  @map("place_id")
  locale  String  @db.VarChar(10)
  name    String
  address String
  summary String?
  place   Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, locale])
  @@index([locale, name])
  @@map("place_translations")
}

model PlaceProviderRef {
  id         String           @id @default(cuid())
  placeId    String           @map("place_id")
  provider   ExternalProvider
  externalId String           @map("external_id")
  sourceUrl  String?          @map("source_url")
  place      Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([placeId])
  @@map("place_provider_refs")
}

model Happening {
  id           String                 @id @default(cuid())
  placeId      String                 @map("place_id")
  sourceType   SourceType             @map("source_type")
  status       HappeningStatus        @default(UPCOMING)
  kind         HappeningKind?
  startsAt     DateTime               @map("starts_at")
  endsAt       DateTime               @map("ends_at")
  isAnchor     Boolean                @default(false) @map("is_anchor")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  place        Place                  @relation(fields: [placeId], references: [id], onDelete: Restrict)
  translations HappeningTranslation[]
  providerRefs HappeningProviderRef[]
  occurrences  ScheduleOccurrence[]

  @@index([status, startsAt, endsAt])
  @@index([kind, status, startsAt])
  @@index([isAnchor, status, endsAt])
  @@index([placeId])
  @@map("happenings")
}

model HappeningTranslation {
  id           String    @id @default(cuid())
  happeningId  String    @map("happening_id")
  locale       String    @db.VarChar(10)
  title        String
  description  String?
  scheduleText String?   @map("schedule_text")
  happening    Happening @relation(fields: [happeningId], references: [id], onDelete: Cascade)

  @@unique([happeningId, locale])
  @@map("happening_translations")
}

model HappeningProviderRef {
  id            String           @id @default(cuid())
  happeningId   String           @map("happening_id")
  provider      ExternalProvider
  externalId    String           @map("external_id")
  sourceUrl     String?          @map("source_url")
  bookingUrl    String?          @map("booking_url")
  lastFetchedAt DateTime         @map("last_fetched_at")
  happening     Happening        @relation(fields: [happeningId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([happeningId])
  @@index([provider, lastFetchedAt])
  @@map("happening_provider_refs")
}

model ScheduleOccurrence {
  id          String                   @id @default(cuid())
  happeningId String                   @map("happening_id")
  startsAt    DateTime                 @map("starts_at")
  endsAt      DateTime?                @map("ends_at")
  status      ScheduleOccurrenceStatus @default(SCHEDULED)
  bookingUrl  String?                  @map("booking_url")
  happening   Happening                @relation(fields: [happeningId], references: [id], onDelete: Cascade)

  @@unique([happeningId, startsAt])
  @@index([status, startsAt])
  @@map("schedule_occurrences")
}

model PlaceOpeningPeriod {
  id              String @id @default(cuid())
  placeId         String @map("place_id")
  dayOfWeek       Int    @map("day_of_week")
  opensAtMinutes  Int    @map("opens_at_minutes")
  closesAtMinutes Int    @map("closes_at_minutes")
  place           Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek, opensAtMinutes])
  @@index([placeId, dayOfWeek])
  @@map("place_opening_periods")
}

model PlaceOpeningException {
  id              String   @id @default(cuid())
  placeId         String   @map("place_id")
  date            DateTime @db.Date
  isClosed        Boolean  @default(false) @map("is_closed")
  opensAtMinutes  Int?     @map("opens_at_minutes")
  closesAtMinutes Int?     @map("closes_at_minutes")
  note            String?
  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, date])
  @@index([date])
  @@map("place_opening_exceptions")
}

model IngestionRecord {
  id                String           @id @default(cuid())
  ingestionRunId    String?          @map("ingestion_run_id")
  provider          ExternalProvider
  externalId        String           @map("external_id")
  checksum          String
  status            IngestionStatus  @default(STAGED)
  sourceUrl         String?          @map("source_url")
  rawPayload        Json             @map("raw_payload")
  normalizedPayload Json?            @map("normalized_payload")
  errorMessage      String?          @map("error_message")
  fetchedAt         DateTime         @map("fetched_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  ingestionRun      IngestionRun?    @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId, checksum])
  @@index([status, fetchedAt])
  @@index([provider, fetchedAt])
  @@index([ingestionRunId, createdAt])
  @@map("ingestion_records")
}

model IngestionRun {
  id             String             @id @default(cuid())
  provider       ExternalProvider
  status         IngestionRunStatus @default(RUNNING)
  trigger        IngestionTrigger
  actorId        String             @map("actor_id")
  actorType      ActorType          @map("actor_type")
  requestPayload Json               @map("request_payload")
  totalAvailable Int?               @map("total_available")
  fetched        Int                @default(0)
  selected       Int                @default(0)
  inserted       Int                @default(0)
  unchanged      Int                @default(0)
  errorMessage   String?            @map("error_message")
  startedAt      DateTime           @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  records        IngestionRecord[]

  @@index([status, startedAt, id])
  @@index([provider, startedAt, id])
  @@map("ingestion_runs")
}

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  creatorUserId   String?      @map("creator_user_id")
  coupleId        String?      @map("couple_id")
  status          CourseStatus @default(DRAFT)
  sourceType      SourceType?  @map("source_type")
  title           String
  description     String?
  coverImageUrl   String?      @map("cover_image_url")
  durationMinutes Int?         @map("duration_minutes")
  dayCount        Int          @default(1) @map("day_count")
  dayStartMinutes Int          @default(600) @map("day_start_minutes")
  dayEndMinutes   Int          @default(1320) @map("day_end_minutes")
  targetStopCount Int          @default(3) @map("target_stop_count")
  viewCount       Int          @default(0) @map("view_count")
  scrapCount      Int          @default(0) @map("scrap_count")
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  creatorUser     User?        @relation("SoloCourseCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  couple          Couple?      @relation(fields: [coupleId], references: [id], onDelete: Restrict)
  nodes           CourseNode[]
  tags            CourseTag[]
  scraps          Scrap[]

  @@index([status, publishedAt, id])
  @@index([sourceType, status, publishedAt, id])
  @@index([coupleId, createdAt])
  @@index([creatorUserId, createdAt])
  @@map("courses")
}

model CourseNode {
  id              String  @id @default(cuid())
  courseId        String  @map("course_id")
  placeId         String  @map("place_id")
  orderIndex      Int     @map("order_index")
  dayIndex        Int     @default(1) @map("day_index")
  durationMinutes Int?    @default(60) @map("duration_minutes")
  distanceMeters  Int?    @map("distance_meters")
  tip             String? @db.VarChar(50)
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  place           Place   @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([courseId, orderIndex])
  @@index([courseId, dayIndex, orderIndex])
  @@index([placeId])
  @@map("course_nodes")
}

model Tag {
  id        String      @id @default(cuid())
  kind      TagKind
  slug      String      @unique
  labelKo   String      @map("label_ko")
  labelEn   String      @map("label_en")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")
  courses   CourseTag[]
  places    PlaceTag[]

  @@index([kind, isActive])
  @@map("tags")
}

model CourseTag {
  courseId String @map("course_id")
  tagId    String @map("tag_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([courseId, tagId])
  @@index([tagId, courseId])
  @@map("course_tags")
}

model PlaceTag {
  placeId String @map("place_id")
  tagId   String @map("tag_id")
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([placeId, tagId])
  @@index([tagId, placeId])
  @@map("place_tags")
}

model Scrap {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
  @@map("scraps")
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String    @map("actor_id")
  actorType  ActorType @map("actor_type")
  action     String
  targetType String    @map("target_type")
  targetId   String    @map("target_id")
  before     Json?
  after      Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("audit_logs")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  name       String
  properties Json
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}
